# API keys
OPENROUTER_API_KEY=
LANGCHAIN_API_KEY=
LANGCHAIN_TRACING_V2=true
PAGEINDEX_API_KEY=

MAX_INPUT_CHARS=10000

# Generate each with: python -c "import secrets; print(secrets.token_urlsafe(64))"
# Must be at least 32 chars and must differ from each other.
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRATION=3600

JWT_REFRESH_TOKEN_SECRET=
JWT_REFRESH_TOKEN_ALGORITHM=HS256
JWT_REFRESH_TOKEN_EXPIRATION=86400

GPTCACHE_URL=http://localhost:8001
RIVAL_URL=http://localhost:8002
MONGODB_URI=mongodb://localhost:27017
POSTGRES_DSN=postgresql://postgres:postgres@localhost:5432/support_bot

OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LOW_COMPLEXITY_MODEL=google/gemini-2.0-flash-001
HIGH_COMPLEXITY_MODEL=google/gemini-2.5-pro
FAITHFULNESS_MODEL=openai/gpt-4o-mini

FAITHFULNESS_THRESHOLD=0.7
COMPLETENESS_THRESHOLD=0.7

MAX_SESSION_TURNS=10

# Eval config (used by CI/CD). EVAL_JWT_SECRET must match JWT_SECRET of the target app.
EVAL_APP_URL=http://localhost:8000
EVAL_JWT_SECRET=
